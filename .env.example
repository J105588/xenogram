# =====================================================================
# 常設（どの環境で動かす場合も必要）
# =====================================================================

# Discord Bot Settings
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_server_id_here # オプション: スラッシュコマンドを特定のサーバーに即時反映させる場合
DISCORD_CHANNEL_ID=your_discord_channel_id_here # 通知を送信するチャンネルID

# データはこのマシン上の data/xenogram.sqlite に保存される（外部DB不要・設定項目なし）

TZ=Asia/Tokyo # サーバー全体のタイムゾーン指定

# 監視対象のニコニコユーザーID（複数可・カンマ区切り。例: "143305795,987654321"）
NICO_USER_IDS=143305795

# マイルストーン（キリ番）の判定単位。動画の再生数規模が大きくなってきたら 1000 等に
MILESTONE_STEP=100

# =====================================================================
# ボカコレ / ランキング監視
# =====================================================================
VOCACOLLE_ENABLED=true                                          # false で機能ごと停止
# 監視対象ランキングのURL（複数可・カンマ区切り。ボカコレ以外のニコニコ内ランキングも指定可）
VOCACOLLE_RANKING_URLS=https://vocaloid-collection.jp/ranking/rookie/
VOCACOLLE_CRON=5 * * * *                                        # 既定: 毎時5分 (JST)
VOCACOLLE_CHANNEL_ID=                                           # 未指定なら DISCORD_CHANNEL_ID を使用
VOCACOLLE_FETCH_TIMEOUT_MS=15000
VOCACOLLE_RANK_CHANGE_THRESHOLD=10                              # 順位がこの数値以上動いたら通知

# =====================================================================
# 急上昇検知・週次レポート
# =====================================================================
SPIKE_DETECTION_ENABLED=true
SPIKE_VIEW_THRESHOLD_PER_HOUR=500                               # 1時間あたりこの再生数以上伸びたら通知
SPIKE_COOLDOWN_HOURS=6                                          # 同じ動画への連続通知を防ぐ間隔

WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_CRON=0 21 * * 0                                   # 既定: 毎週日曜21:00 (JST)

# =====================================================================
# スクリーンショット (Puppeteer)
# =====================================================================
SCREENSHOT_ENABLED=true
PUPPETEER_EXECUTABLE_PATH=                                      # システムのChromeを使う場合のみ指定。未使用なら行ごと削除してよい
SCREENSHOT_TIMEOUT_MS=60000
SCREENSHOT_VIEWPORT_WIDTH=1440
SCREENSHOT_VIEWPORT_HEIGHT=1000
SCREENSHOT_SCALE=2                                              # 2=高精細。メモリ制約のあるホスティングでは 1

# =====================================================================
# Renderにデプロイする場合のみ（PM2でのローカル/自宅サーバー運用では丸ごと不要）
# =====================================================================
PORT=3000
# 重要: 設定する場合は必ず具体的な値にする（空文字にしない）。
# 空文字にすると Puppeteer のキャッシュパス解決が壊れ、
# "Could not find Chrome" エラーで起動時にクラッシュする。
# 使わない場合は変数ごと削除すること。
PUPPETEER_CACHE_DIR=/opt/render/project/.cache/puppeteer
