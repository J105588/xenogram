# Discord Bot Settings
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_server_id_here # オプション: スラッシュコマンドを特定のサーバーに即時反映させる場合
DISCORD_CHANNEL_ID=your_discord_channel_id_here # 通知を送信するチャンネルID

# Supabase Settings
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# App Settings
PORT=3000
TZ=Asia/Tokyo # サーバー全体のタイムゾーン指定
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com # Render上の自身のURL (スリープ回避用)

# ボカコレ ランキング監視
VOCACOLLE_ENABLED=true                                          # false で機能ごと停止
VOCACOLLE_RANKING_URL=https://vocaloid-collection.jp/ranking/rookie/
VOCACOLLE_CRON=5 * * * *                                        # 既定: 毎時5分 (JST)
VOCACOLLE_CHANNEL_ID=                                           # 未指定なら DISCORD_CHANNEL_ID を使用
VOCACOLLE_FETCH_TIMEOUT_MS=15000

# スクリーンショット (Puppeteer)
SCREENSHOT_ENABLED=true
PUPPETEER_EXECUTABLE_PATH=                                      # システムのChromeを使う場合のみ指定。未使用なら行ごと削除してよい
SCREENSHOT_TIMEOUT_MS=90000
SCREENSHOT_VIEWPORT_WIDTH=1280
SCREENSHOT_VIEWPORT_HEIGHT=800
SCREENSHOT_SCALE=1                                              # 低メモリ環境では 1 のまま
# 重要: Renderに設定する場合は必ずこの値のまま（空文字にしない）。
# 空文字にすると Puppeteer のキャッシュパス解決が壊れ、
# "Could not find Chrome" エラーで起動時にクラッシュする。
# 使わない場合は変数ごと削除すること（空値のままでは絶対に置かない）。
PUPPETEER_CACHE_DIR=/opt/render/project/.cache/puppeteer
